{% extends "@NovosgaScheduling/base.html.twig" %}

{% trans_default_domain 'NovosgaSchedulingBundle' %}

{% block body %}
    <div class="d-flex align-items-start mb-4">
        <div>
            <h1>
                <i class="fa fa-cog" aria-hidden="true"></i> {{ 'config_title'|trans }}
            </h1>
            <p class="text-muted">{{ 'config_subtitle'|trans }}</p>
        </div>
        <div class="ms-auto pt-3 d-flex gap-2">
            <a href="{{ path('novosga_scheduling_config_new') }}" class="btn btn-primary">
                <i class="fa fa-plus"></i>
                {{ 'button.new_config'|trans }}
            </a>
            <a href="{{ path('novosga_scheduling_index') }}" class="btn btn-outline-secondary">
                <i class="fa fa-address-book"></i>&nbsp;
                {{ 'title'|trans }}
            </a>
        </div>
    </div>

    {% include 'flashMessages.html.twig' %}

    {% if unidadeConfig %}
        <div class="card mb-4">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="fa fa-plug fa-lg text-secondary"></i>
                <div class="flex-grow-1">
                    <div class="fw-semibold">{{ 'label.integration'|trans }}</div>
                    <div class="text-muted small">
                        {{ unidadeConfig.provider }}{% if unidadeConfig.apiUrl %} &mdash; {{ unidadeConfig.apiUrl }}{% endif %}
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <form action="{{ path('novosga_scheduling_config_sync') }}" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="fa fa-refresh"></i> {{ 'button.sync'|trans }}
                        </button>
                    </form>
                    <a href="{{ path('novosga_scheduling_config_start') }}" class="btn btn-sm btn-outline-secondary">
                        <i class="fa fa-edit"></i> {{ 'button.edit_integration'|trans }}
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    <h5>{{ 'label.service_configs'|trans }}</h5>

    {% if servicoConfigs is empty %}
        <div class="text-center text-muted py-5 border rounded">
            <i class="fa fa-calendar-o fa-2x d-block mb-2"></i>
            <p class="mb-2">{{ 'label.service_configs.empty'|trans }}</p>
            <a href="{{ path('novosga_scheduling_config_new') }}" class="btn btn-sm btn-primary">
                <i class="fa fa-plus"></i> {{ 'button.new_config'|trans }}
            </a>
        </div>
    {% else %}
        <table class="table table-hover border">
            <thead>
                <tr class="table-primary">
                    <th>{{ 'label.local_service'|trans }}</th>
                    <th>{{ 'label.remote_service'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for config in servicoConfigs %}
                    <tr>
                        <td>{{ config.servicoLocal.nome }}</td>
                        <td>
                            {% set nomeServicoRemoto = config.servicoRemoto %}
                            {% for servicoRemoto in servicosRemotos %}
                                {% if servicoRemoto.id == config.servicoRemoto %}
                                    {% set nomeServicoRemoto = servicoRemoto.nome %}
                                {% endif %}
                            {% endfor %}
                            {{- nomeServicoRemoto -}}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('novosga_scheduling_config_edit', { id: config.servicoLocal.id }) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="fa fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
